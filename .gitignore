# Dependencies — restored via `npm install`
node_modules/

# TypeScript build output — regenerated via `npm run compile`
out/
*.tsbuildinfo

# Packaged extension binaries — regenerated via `vsce package`
*.vsix

# VS Code test artifacts
.vscode-test/

# Local environment / secrets
.env
.env.local

# Editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports (if tests are added later)
coverage/
.nyc_output/

# Temporary patch helpers (we used these to bypass Edit-tool whitespace issues)
patch.js
